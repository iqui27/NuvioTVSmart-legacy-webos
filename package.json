{
  "name": "nuvio-tv-smart",
  "private": true,
  "type": "module",
  "version": "0.3.43",
  "license": "GPL-3.0",
  "author": "iqui27",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iqui27/NuvioTVSmart-legacy-webos.git"
  },
  "homepage": "https://github.com/NuvioMedia/NuvioTVSmart",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepare": "husky || true",
    "build:on-release": "node ./scripts/release-build-poller.mjs",
    "install:webos": "node ./scripts/ares-install-webos.mjs",
    "inspect:webos": "node ./scripts/ares-inspect-webos.mjs",
    "logs:webos": "node ./scripts/ares-logs-webos.mjs",
    "media:webos-sim": "node --require ./scripts/localhost-listen-patch.cjs ./services/webos/runtime/media-http.cjs",
    "lint": "npm run lint:home:incremental",
    "lint:home:incremental": "eslint \"js/ui/screens/home/**/*.js\" \"eslint.config.mjs\"",
    "package:tizen": "npm run build && node ./scripts/package-tizen.mjs",
    "package:tizen:store": "npm run build && node ./scripts/package-tizen.mjs --store",
    "package:webos": "npm run build && node ./scripts/package-webos.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "node ./scripts/serve.mjs",
    "check:legacy-css": "node ./scripts/checkLegacyCss.mjs",
    "sync": "node ./scripts/sync-wrapper.mjs",
    "sync:tizen": "node ./scripts/sync-wrapper.mjs --tizen",
    "sync:webos": "node ./scripts/sync-wrapper.mjs --webos",
    "check:legacy-regex": "node scripts/checkLegacyRegex.mjs",
    "check:no-undef": "node scripts/checkNoUndef.mjs",
    "check:source": "node scripts/checkSourceIntegrity.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^9.39.4",
    "@webos-tools/cli": "^3.2.4",
    "acorn": "^8.17.0",
    "autoprefixer": "^10.4.27",
    "core-js": "3.49.0",
    "core-js-compat": "3.49.0",
    "cssnano": "^7.1.4",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.9",
    "prettier": "^3.8.4"
  },
  "overrides": {
    "flatted": "3.4.2"
  },
  "dependencies": {
    "assjs": "0.1.10",
    "dashjs": "4.7.4",
    "hls.js": "1.5.20",
    "jszip": "^3.10.1",
    "libbitsub": "^1.10.1"
  },
  "bugs": {
    "url": "https://github.com/iqui27/NuvioTVSmart-legacy-webos/issues"
  }
}
